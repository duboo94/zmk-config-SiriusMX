#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_kor { timeout-ms = <50>; key-positions = <33 34>; bindings = <&tog 1>; };
    };

      keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp ESC        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp MINUS      &kp PLUS       &kp N5         &kp N6
            &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &kp I          &kp O          &kp P          &kp LBKT       &kp RBKT       &kp BSPC
            &kp CAPS       &kp A          &kp S          &kp D          &kp F          &kp G          &kp H          &kp J          &kp K          &kp L          &kp SEMI       &kp SQT        &kp ENTER
            &kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &kp N          &kp M          &kp COMMA      &kp DOT        &kp SLASH      &kp LSHIFT     &kp N
            &kp LCTRL      &kp LGUI       &kp LALT       &kp LALT       &kp SPACE      &kp M          &kp SPACE      &kp RALT       &kp LEFT       &kp DOWN       &kp RIGHT
            >;
        };
    };
};
