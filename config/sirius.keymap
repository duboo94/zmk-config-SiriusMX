#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define KOR_COMBO layers = <1>;

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_lang: tap_dance_lang {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RALT>, <&kp CAPS>;
        };

        td_o: tap_dance_o {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&kp LS(O)>;
        };

        td_p: tap_dance_p {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp P>, <&kp LS(P)>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_kor { timeout-ms = <50>; key-positions = <33 34>; bindings = <&tog 1>; };
        combo_lang { timeout-ms = <50>; key-positions = <15 32>; bindings = <&kp RALT>;  KOR_COMBO };
        combo_1 { timeout-ms = <50>; key-positions = <9 32>; bindings = <&kp LS(Q)>; KOR_COMBO };
        combo_2 { timeout-ms = <50>; key-positions = <10 32>; bindings = <&kp LS(W)>; KOR_COMBO };
        combo_3 { timeout-ms = <50>; key-positions = <11 32>; bindings = <&kp LS(E)>; KOR_COMBO };
        combo_4 { timeout-ms = <50>; key-positions = <12 32>; bindings = <&kp LS(R)>; KOR_COMBO };
        combo_5 { timeout-ms = <50>; key-positions = <13 32>; bindings = <&kp LS(T)>; KOR_COMBO };
        combo_6 { timeout-ms = <50>; key-positions = <16 17>; bindings = <&kp Y>; KOR_COMBO };
        combo_7 { timeout-ms = <50>; key-positions = <17 18>; bindings = <&kp U>; KOR_COMBO };
        combo_8 { timeout-ms = <50>; key-positions = <18 19>; bindings = <&kp I>; KOR_COMBO };
        combo_9 { timeout-ms = <50>; key-positions = <19 20>; bindings = <&kp B>; KOR_COMBO };
        combo_10 { timeout-ms = <50>; key-positions = <10 11>; bindings = <&td_p>; KOR_COMBO };
        combo_11 { timeout-ms = <50>; key-positions = <11 12>; bindings = <&td_o>; KOR_COMBO };
    };

      keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp ESC        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7
            &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y
            &kp CAPS       &kp A          &kp S          &kp D          &kp F          &kp G          &kp H
            &kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &kp N
            &kp LCTRL      &kp LGUI       &kp LALT       &kp SPACE      &kp M          &kp U
            >;
        };

        kor_layer {
            bindings = <
            &kp ESC        &ht F1 N1      &ht F2 N2      &ht F3 N3      &ht F4 N4      &ht F5 N5      &ht F6 N6      &ht F7 N7
            &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y
            &kp TAB        &kp A          &kp S          &kp D          &kp F          &ht G L        &kp H
            &kp LSHFT      &ht Z H        &ht X J        &ht C M        &ht V K        &ht B N        &kp N
            &kp LCTRL      &kp LGUI       &kp LALT       &kp SPACE      &kp M          &kp U
            >;
        };

        fn_layer {
            bindings = <
            &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp F6
            &trans         &trans         &trans         &trans         &trans         &trans         &trans
            &trans         &trans         &trans         &trans         &trans         &trans         &trans
            &kp COMMA       &kp DOT       &trans         &trans         &trans         &trans
            &kp C_VOL_DN   &kp C_VOL_UP   &trans         &trans         &trans         &trans
            >;
        };
    };
};
