#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td_lang: tap_dance_lang {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RALT>, <&kp CAPS>;
        };

        td_o: tap_dance_o {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&kp LS(O)>;
        };

        td_p: tap_dance_p {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp P>, <&kp LS(P)>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_lang { timeout-ms = <50>; key-positions = <0 1>; bindings = <&kp ESC>; };
    };

      keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp Q      &kp W     &kp E      &kp R      &kp T
            &kp A      &kp S      &kp D      &kp F      &kp G
            &kp Z      &kp X      &kp C      &kp V      &kp B
            &mo(1)    &mo(2)     &kp ENTER   &kp SPACE
            >;
        };

        kor_layer {
            bindings = <
            &kp Q      &kp S      &kp D      &kp R      &kp T      &kp E
            &kp M     &kp L      &kp K      &kp J      &kp H      &kp N
            &kp Z      &kp A      &kp W      &kp F      &kp V      &trans
            &mo(1)    &mo(2)     &kp ENTER   &kp SPACE
            >;
        };
    };
};
